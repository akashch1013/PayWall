# Copy to server/.env and adjust. Never commit server/.env.

# Local MongoDB (default). For MongoDB Atlas use:
# mongodb+srv://<user>:<password>@<cluster-host>/rewear?appName=<app>
MONGODB_URI=mongodb://127.0.0.1:27017/rewear

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=4000
