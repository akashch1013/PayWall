# Copy to .env and fill in. .env is git-ignored.

# Tests create (and drop) a throwaway database on this server.
# The user needs CREATEDB permission. The database in the URL is only used to connect.
PAYWALL_TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/postgres

# Running PayWall itself (paywall migrate / serve, or PayWall.from_env()).
# PAYWALL_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/app
# PAYWALL_DB_SCHEMA=paywall
# PAYWALL_DEFAULT_CURRENCY=INR

# Standalone server. Leave JWT_SECRET unset to disable user tokens (>= 32 characters).
# PAYWALL_JWT_SECRET=
# PAYWALL_JWT_TTL_MINUTES=60
# PAYWALL_LOG_LEVEL=INFO
# PAYWALL_LOG_JSON=true
